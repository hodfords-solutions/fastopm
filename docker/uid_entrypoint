#!/bin/sh
# Same contract as Verdaccio's docker-bin/uid_entrypoint: when the container runs with an
# arbitrary UID (OpenShift, `docker run --user`), add a passwd entry for it so tools that look
# the user up keep working, then run the command under dumb-init (signal forwarding, zombie
# reaping).

if ! whoami > /dev/null 2>&1; then
  if [ -w /etc/passwd ]; then
    echo "${VERDACCIO_USER_NAME:-default}:x:$(id -u):0:${VERDACCIO_USER_NAME:-default} user:${HOME}:/usr/sbin/nologin" >> /etc/passwd
  fi
fi

exec /usr/bin/dumb-init -- "$@"
